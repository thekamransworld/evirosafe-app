rules_version = '2';

// ── How this works ──────────────────────────────────────────────────────────
// Firestore rules can only look up a document by its exact known path — they
// can't run a query like "where auth_uid == X" the way client code can. This
// app's user documents keep their original invite-time ID forever (see the
// comment in AuthContext.tsx's signup() for why), so the document ID is NOT
// the same as the Firebase Auth UID. To bridge that, every activated account
// gets a small pointer doc at users_by_uid/{authUid} containing just
// { docId, org_id, role }. These rules read that pointer to find out who's
// asking and what org they belong to, then scope everything else by org_id.
//
// If you change how a user's role or org_id gets set anywhere in the app,
// make sure the matching users_by_uid/{authUid} doc gets updated too — see
// handleUpdateUser and signup() in the codebase, both of which already do
// this. A stale pointer means stale permissions.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myPointer() {
      return get(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)).data;
    }

    function myOrgId() {
      return myPointer().org_id;
    }

    function myRole() {
      return myPointer().role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() in ['ADMIN', 'ORG_ADMIN'];
    }

    // True if `data` (a resource's fields) belongs to the caller's own org —
    // UNLESS the caller is the platform-level ADMIN role, which is allowed to
    // act across every org. ORG_ADMIN (a real customer's own administrator)
    // is intentionally NOT included here — they should only ever manage
    // their own org, same as everyone else. Evaluates to false (not an
    // error) if the caller has no pointer doc yet — covers the brief window
    // between signup and the pointer being written.
    function isOrgScoped(data) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)) &&
        (myRole() == 'ADMIN' || data.org_id == myOrgId());
    }

    // ---- Pointer collection ----
    // Only the account owner can ever read or write their own pointer. Never
    // listable — nobody queries this collection, they always know their own
    // UID (it's their own auth.uid), which is all this collection is keyed by.
    match /users_by_uid/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- Users ----
    match /users/{userId} {
      // AuthSync resolves identity in three ways, and each one needs its own
      // directly-provable condition here — Firestore can only approve a query
      // against a rule that references the exact field the query filters by,
      // so a compound condition that never mentions auth_uid can never approve
      // a query filtered on auth_uid, no matter how it's combined with OR.
      allow read: if isSignedIn() && (
        resource.data.auth_uid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isOrgScoped(resource.data)
      );
      // Invites create new user docs before that person has ever signed in,
      // so this can't require the pointer to exist — only that the creator
      // is a real admin of the org they're inviting into, UNLESS that admin
      // is the platform-level ADMIN role, who can invite into any org.
      allow create: if isAdmin() && (myRole() == 'ADMIN' || request.resource.data.org_id == myOrgId());
      // You can always update your own record (self-service profile changes);
      // admins can update anyone in their own org. Nobody can move a record
      // to a different org_id than it already had via this path.
      allow update: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        (isAdmin() && isOrgScoped(resource.data))
      ) && request.resource.data.org_id == resource.data.org_id;
      allow delete: if isAdmin() && isOrgScoped(resource.data);
    }

    function myProjectIds() {
      return myPointer().get('project_ids', []);
    }

    // Every role except ADMIN and ORG_ADMIN only sees data within their own
    // assigned project(s), not everything in the org. New roles added later
    // default to restricted too, unless explicitly added to the org-wide list
    // here — the safer default.
    function isProjectRestricted() {
      return !(myRole() in ['ADMIN', 'ORG_ADMIN']);
    }

    // Like isOrgScoped, but for project-restricted roles also requires the
    // document's project_id to be one of the caller's assigned projects.
    // Documents with no project_id field at all (org-wide catalog data, e.g.
    // a training course template) are unaffected — only documents that are
    // actually tied to a specific project get restricted.
    function isAccessible(data) {
      return isOrgScoped(data) &&
        (!isProjectRestricted() ||
         !('project_id' in data) ||
         data.project_id in myProjectIds());
    }

    // ---- Organizations ----
    // Orgs aren't org_id-scoped themselves (they ARE the org) — scoped by
    // the document's own ID matching the caller's org_id instead, UNLESS
    // the caller is the platform-level ADMIN role, who can see and manage
    // every organization, not just their own.
    match /organizations/{orgId} {
      allow read: if isSignedIn() && (myRole() == 'ADMIN' || orgId == myOrgId());
      // Creating a brand-new org has no existing pointer to check against yet
      // — this is the bootstrap path. Anyone signed in can create one; update
      // and delete require already being an admin of that specific org, or
      // being the platform-level ADMIN role.
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() && (myRole() == 'ADMIN' || orgId == myOrgId());
    }

    // ---- Every other collection: same rule, org_id must match ----
    match /projects/{docId}            { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /reports/{docId}             { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /inspections/{docId}         { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    // >>> PTW: generated by scripts/gen-ptw-rules.mjs from src/lib/ptw/model.ts. Do not edit by hand.
    // Regenerate with: npm run gen:ptw-rules      Verify in CI with: npm run check:ptw-rules
    //
    // ENFORCED HERE   who may make which transition (role, requester vs reviewer, and the
    //                 administrator override), the validity window (stamped from server time,
    //                 capped by permit type and by 7 days in total), an append-only log, and
    //                 server-stamped transition times.
    // NOT ENFORCED    the CONTENT of a permit (certificates, gas readings, isolation, checklists).
    //                 Those gates run in the app only. Password re-entry is also app-only.
    // CLOCK           a device clock more than 10 minutes off is refused on activation/revalidation.

    function ptwMaxMinutes(permitType) {
      return permitType in ['Hot Work', 'Confined Space Entry', 'Chemical Handling'] ? 490
        : permitType in ['Work at Height', 'Electrical Work', 'Excavation', 'Lifting', 'Utility Work', 'Mechanical Work', 'Night Work'] ? 730
        : permitType in ['Road Closure', 'General Work'] ? 1450
        : 0;
    }

    // from-stage -> to-stage, for this role. Generated from ACTIONS in model.ts.
    function ptwTransitionOk(fromStage, toStage, role, isRequester, overridden) {
      return toStage == 'SUBMITTED'
        ? ((fromStage == 'DRAFT' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD'] && (isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'SITE_INSPECTION'
        ? ((fromStage == 'SUBMITTED' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'CUSTOM_SITE_LEAD'] && (!isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'APPROVAL'
        ? ((fromStage == 'SITE_INSPECTION' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'CUSTOM_SITE_LEAD'] && (!isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'SITE_HANDOVER'
        ? ((fromStage == 'APPROVAL' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER'] && (!isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'ACTIVE'
        ? ((fromStage == 'SITE_HANDOVER' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD'] && (isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN'])))
            || (fromStage == 'HOLD' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'CUSTOM_SITE_LEAD'] && (!isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN'])))
            || (fromStage == 'ACTIVE' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'CUSTOM_SITE_LEAD'] && (!isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'HOLD'
        ? ((fromStage == 'ACTIVE' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD'])
            || (fromStage == 'COMPLETION_PENDING' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'CUSTOM_SITE_LEAD'] && (!isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'COMPLETION_PENDING'
        ? ((fromStage in ['ACTIVE', 'HOLD', 'EXPIRED'] && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD'] && (isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'CLOSED'
        ? ((fromStage == 'COMPLETION_PENDING' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'CUSTOM_SITE_LEAD'] && (!isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'DRAFT'
        ? ((fromStage in ['SUBMITTED', 'SITE_INSPECTION', 'APPROVAL'] && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'CUSTOM_SITE_LEAD'] && (!isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'REJECTED'
        ? ((fromStage in ['SUBMITTED', 'SITE_INSPECTION', 'APPROVAL'] && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'CUSTOM_SITE_LEAD'] && (!isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'CANCELLED'
        ? ((fromStage in ['DRAFT', 'SUBMITTED', 'SITE_INSPECTION', 'APPROVAL', 'SITE_HANDOVER'] && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD'] && (isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN'])))
            || (fromStage in ['SUBMITTED', 'SITE_INSPECTION', 'APPROVAL', 'SITE_HANDOVER', 'ACTIVE', 'HOLD', 'EXPIRED', 'COMPLETION_PENDING'] && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'CUSTOM_SITE_LEAD'] && (!isRequester || (overridden && role in ['ADMIN', 'ORG_ADMIN']))))
        : toStage == 'EXPIRED'
        ? ((fromStage == 'ACTIVE' && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD']))
        : toStage == 'ARCHIVED'
        ? ((fromStage in ['CLOSED', 'CANCELLED', 'REJECTED'] && role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER']))
        : false;
    }

    // One pointer read; mirrors isAccessible(). Pass the pointer in so it is read once.
    function ptwInScope(me, data) {
      return me.role == 'ADMIN' ||
        (data.org_id == me.org_id &&
          (me.role == 'ORG_ADMIN' || !('project_id' in data) || data.project_id in me.get('project_ids', [])));
    }

    function ptwIsRequester(me, data) {
      return me.docId == data.get('creator_id', '') || me.docId == data.get('receiver_id', '');
    }

    function ptwLastLog(data) {
      return data.workflow_log[data.workflow_log.size() - 1];
    }

    // The log grows by exactly one entry, earlier entries are untouched, and the
    // new entry names the person actually making the request.
    function ptwLogAppendOk(me, before, after) {
      let prev = before.get('workflow_log', []);
      let entries = after.workflow_log;
      let last = entries[entries.size() - 1];
      return entries is list
        && entries.size() == prev.size() + 1
        && entries[0:prev.size()] == prev
        && last.user_id == me.docId
        && last.stage == after.status
        && last.action is string
        && last.timestamp is string
        && (last.get('override', false) != true
            || (me.role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER']
                && last.get('justification', '') is string
                && last.get('justification', '').size() >= 10));
    }

    // Only the logged-in user can sign a slot. Only a send-back may clear signatures.
    function ptwSignaturesOk(me, before, after) {
      let sigs = after.get('signatures', {});
      let changed = sigs.diff(before.get('signatures', {})).affectedKeys();
      return changed.hasOnly(['requester', 'prescreen', 'inspection', 'approval', 'handover', 'completion_request', 'closure'])
        && (after.status == 'DRAFT' || sigs.diff(before.get('signatures', {})).removedKeys().size() == 0)
        && (!('requester' in changed) || !('requester' in sigs) || sigs.requester.user_id == me.docId)
        && (!('prescreen' in changed) || !('prescreen' in sigs) || sigs.prescreen.user_id == me.docId)
        && (!('inspection' in changed) || !('inspection' in sigs) || sigs.inspection.user_id == me.docId)
        && (!('approval' in changed) || !('approval' in sigs) || sigs.approval.user_id == me.docId)
        && (!('handover' in changed) || !('handover' in sigs) || sigs.handover.user_id == me.docId)
        && (!('completion_request' in changed) || !('completion_request' in sigs) || sigs.completion_request.user_id == me.docId)
        && (!('closure' in changed) || !('closure' in sigs) || sigs.closure.user_id == me.docId);
    }

    // A transition may only touch payload.holding_or_stoppage.
    function ptwPayloadTransitionOk(before, after) {
      return after.payload.diff(before.payload).affectedKeys().hasOnly(['holding_or_stoppage']);
    }

    // Stoppage records are an audit trail. Going on hold appends exactly ONE record; on resume
    // only the latest record may be completed; every other transition leaves them untouched.
    // Nothing is ever removed or rewritten.
    function ptwStoppageOk(before, after) {
      let prev = before.payload.get('holding_or_stoppage', []);
      let next = after.payload.get('holding_or_stoppage', []);
      return after.status == 'HOLD'
        ? (next.size() == prev.size() + 1 && next[0:prev.size()] == prev)
        : (before.status == 'HOLD' && after.status == 'ACTIVE')
        ? (next.size() == prev.size() && (next.size() == 0 || next[0:next.size() - 1] == prev[0:prev.size() - 1]))
        : next == prev;
    }

    // Only the new stage's timestamp may change, and it must be server time.
    function ptwStageTimesOk(before, after) {
      let times = after.stage_times;
      return times is map
        && times[after.status] == request.time
        && times.diff(before.get('stage_times', {})).affectedKeys().hasOnly([after.status]);
    }

    function ptwSameWindow(before, after) {
      return after.get('valid_from_ts', null) == before.get('valid_from_ts', null)
        && after.get('valid_until_ts', null) == before.get('valid_until_ts', null)
        && after.get('first_activated_ts', null) == before.get('first_activated_ts', null)
        && after.get('valid_from', null) == before.get('valid_from', null)
        && after.get('valid_until', null) == before.get('valid_until', null)
        && after.get('first_activated_at', null) == before.get('first_activated_at', null)
        && after.get('extensions', []) == before.get('extensions', []);
    }

    // Validity is stamped from SERVER time and capped by permit type and by 7 days in
    // total. Revalidation is refused after expiry. Resume never extends. Expire only after the end.
    // 10 minutes of clock-skew allowance because the client computes the end time.
    function ptwValidityOk(before, after) {
      let fromStage = before.status;
      let toStage = after.status;
      let max = ptwMaxMinutes(before.type);
      let exts = before.get('extensions', []);
      return (fromStage == 'SITE_HANDOVER' && toStage == 'ACTIVE')
        ? (after.valid_from_ts == request.time
            && after.first_activated_ts == request.time
            && after.valid_until_ts is timestamp
            && after.valid_until_ts > request.time
            && after.valid_until_ts <= request.time + duration.value(max, 'm')
            && after.get('extensions', []) == exts)
        : (fromStage == 'ACTIVE' && toStage == 'ACTIVE')
        ? (before.valid_until_ts >= request.time
            && after.valid_until_ts is timestamp
            && after.valid_until_ts > before.valid_until_ts
            && after.valid_until_ts <= request.time + duration.value(max, 'm')
            && after.valid_until_ts <= before.first_activated_ts + duration.value(10090, 'm')
            && after.valid_from_ts == before.valid_from_ts
            && after.first_activated_ts == before.first_activated_ts
            && after.get('extensions', []).size() == exts.size() + 1
            && after.extensions[0:exts.size()] == exts)
        : (fromStage == 'ACTIVE' && toStage == 'EXPIRED')
        ? (request.time > before.valid_until_ts && ptwSameWindow(before, after))
        : (fromStage == 'HOLD' && toStage == 'ACTIVE')
        ? (before.valid_until_ts >= request.time && ptwSameWindow(before, after))
        : ptwSameWindow(before, after);
    }

    function ptwTransitionUpdate(me, before, after) {
      return after.diff(before).affectedKeys().hasOnly(['status', 'workflow_log', 'last_transition_at', 'stage_times', 'signatures', 'valid_from', 'valid_until', 'first_activated_at', 'valid_from_ts', 'valid_until_ts', 'first_activated_ts', 'extensions', 'payload', 'updated_at'])
        && after.last_transition_at == request.time
        && ptwTransitionOk(before.status, after.status, me.role, ptwIsRequester(me, before),
                           ptwLastLog(after).get('override', false) == true)
        && ptwLogAppendOk(me, before, after)
        && ptwSignaturesOk(me, before, after)
        && ptwPayloadTransitionOk(before, after)
        && ptwStoppageOk(before, after)
        && ptwStageTimesOk(before, after)
        && ptwValidityOk(before, after);
    }

    // Content edits never touch status, log, signatures, validity or stoppage records.
    // A draft: its creator, receiver or an approver. After that, only the stages where
    // site staff record work.
    function ptwContentUpdate(me, before, after) {
      let changed = after.diff(before).affectedKeys();
      return me.role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD']
        && after.status == before.status
        && !after.payload.diff(before.payload).affectedKeys().hasAny(['holding_or_stoppage'])
        && (before.status == 'DRAFT'
            ? ((ptwIsRequester(me, before) || me.role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER']) && changed.hasOnly(['title', 'payload', 'receiver_id', 'updated_at']))
            : (before.status in ['SITE_INSPECTION', 'SITE_HANDOVER', 'ACTIVE', 'HOLD', 'EXPIRED', 'COMPLETION_PENDING'] && changed.hasOnly(['payload', 'updated_at'])));
    }

    // Permits made before the permit-system rebuild have no permit_no and can only be deleted.
    function ptwUpdateOk(before, after) {
      let me = myPointer();
      return 'permit_no' in before
        && ptwInScope(me, before)
        && (after.get('workflow_log', []) != before.get('workflow_log', [])
            ? ptwTransitionUpdate(me, before, after)
            : ptwContentUpdate(me, before, after));
    }

    function ptwCounterBumped(d) {
      let c = /databases/$(database)/documents/counters/$('ptw_' + d.org_id + '_' + string(d.permit_year));
      return getAfter(c).data.value == (exists(c) ? get(c).data.value : 0) + 1;
    }

    function ptwMirrorMatches(docId, d) {
      let m = getAfter(/databases/$(database)/documents/ptw_public/$(d.public_token)).data;
      return m.permit_id == docId && m.org_id == d.org_id && m.token == d.public_token;
    }

    // A new permit is always a DRAFT, owned by the person creating it, numbered by
    // consuming the next counter value in the same transaction, with a server-stamped start.
    function ptwCreateOk(docId, d) {
      let me = myPointer();
      return me.role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD']
        && ptwInScope(me, d)
        && d.keys().hasOnly(['org_id', 'project_id', 'type', 'status', 'title', 'payload', 'approvals', 'audit_log', 'updated_at', 'workflow_log', 'permit_no', 'permit_year', 'public_token', 'creator_id', 'receiver_id', 'last_transition_at', 'stage_times', 'signatures', 'extensions'])
        && d.keys().hasAll(['org_id', 'project_id', 'type', 'status', 'title', 'payload', 'approvals', 'audit_log', 'updated_at', 'workflow_log', 'permit_no', 'permit_year', 'public_token', 'creator_id', 'last_transition_at', 'stage_times', 'signatures', 'extensions'])
        && d.status == 'DRAFT'
        && d.type in ['Hot Work', 'Confined Space Entry', 'Chemical Handling', 'Work at Height', 'Electrical Work', 'Excavation', 'Lifting', 'Utility Work', 'Mechanical Work', 'Night Work', 'Road Closure', 'General Work']
        && d.creator_id == me.docId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.payload is map
        && d.permit_year is int
        && d.permit_year >= request.time.year() - 1 && d.permit_year <= request.time.year() + 1
        && d.permit_no is string
        && d.permit_no.matches('PTW-' + string(d.permit_year) + '-[0-9]{4,}')
        && d.public_token is string && d.public_token.size() >= 24
        && d.workflow_log is list && d.workflow_log.size() == 1
        && d.workflow_log[0].user_id == me.docId
        && d.workflow_log[0].stage == 'DRAFT'
        && d.last_transition_at == request.time
        && d.stage_times.keys().hasOnly(['DRAFT'])
        && d.stage_times.DRAFT == request.time
        && d.signatures == {} && d.extensions == [] && d.approvals == [] && d.audit_log == []
        && ptwCounterBumped(d)
        && ptwMirrorMatches(docId, d);
    }

    // A draft can be deleted by its creator or an approver. A permit made before the
    // rebuild (no permit_no) can be deleted by an administrator.
    function ptwDeleteOk(data) {
      let me = myPointer();
      return me.role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD']
        && ptwInScope(me, data)
        && ('permit_no' in data
            ? (data.status == 'DRAFT' && (me.docId == data.get('creator_id', '') || me.role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER']))
            : me.role in ['ADMIN', 'ORG_ADMIN']);
    }

    // The public mirror holds only what a QR scan may show: number, type, status,
    // validity and location. It must agree with the permit it points to.
    function ptwPublicWriteOk(token, mirror) {
      let me = myPointer();
      let p = getAfter(/databases/$(database)/documents/ptws/$(mirror.permit_id)).data;
      return me.role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD']
        && ptwInScope(me, p)
        && p.public_token == token
        && mirror.keys().hasOnly(['token', 'permit_id', 'org_id', 'permit_no', 'type', 'status', 'location', 'valid_from', 'valid_until', 'valid_until_ts', 'updated_at'])
        && mirror.keys().hasAll(['token', 'permit_id', 'org_id', 'permit_no', 'type', 'status', 'location', 'updated_at'])
        && mirror.token == token
        && mirror.org_id == p.org_id
        && mirror.permit_no == p.permit_no
        && mirror.type == p.type
        && mirror.status == p.status
        && mirror.get('valid_until_ts', null) == p.get('valid_until_ts', null)
        && mirror.location is string && mirror.location.size() <= 200;
    }

    function ptwPublicDeleteOk(mirror) {
      let me = myPointer();
      return me.role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD']
        && ptwInScope(me, mirror)
        && !existsAfter(/databases/$(database)/documents/ptws/$(mirror.permit_id));
    }

    // Permit-number counters: one per organisation per year; the value only ever goes up by 1.
    function ptwCounterCreateOk(counterId, d) {
      let me = myPointer();
      return me.role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD']
        && ptwInScope(me, d)
        && d.keys().hasOnly(['org_id', 'year', 'value'])
        && d.value == 1
        && d.year is int
        && counterId == 'ptw_' + d.org_id + '_' + string(d.year);
    }

    function ptwCounterBumpOk(before, after) {
      let me = myPointer();
      return me.role in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'HSE_OFFICER', 'SUPERVISOR', 'INSPECTOR', 'WORKER', 'CUSTOM_SITE_LEAD']
        && ptwInScope(me, before)
        && after.keys().hasOnly(['org_id', 'year', 'value'])
        && after.org_id == before.org_id
        && after.year == before.year
        && after.value == before.value + 1;
    }

    match /ptws/{docId} {
      allow read: if isAccessible(resource.data);
      allow create: if ptwCreateOk(docId, request.resource.data);
      allow update: if ptwUpdateOk(resource.data, request.resource.data);
      allow delete: if ptwDeleteOk(resource.data);
    }

    // Anyone with the QR code can read one status page by its exact token; nobody can list them.
    match /ptw_public/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if ptwPublicWriteOk(token, request.resource.data);
      allow delete: if ptwPublicDeleteOk(resource.data);
    }

    // A missing counter must be readable (resource == null) so the first permit of a year can create it.
    match /counters/{counterId} {
      allow get: if isSignedIn() && (resource == null || ptwInScope(myPointer(), resource.data));
      allow list: if false;
      allow create: if ptwCounterCreateOk(counterId, request.resource.data);
      allow update: if ptwCounterBumpOk(resource.data, request.resource.data);
      allow delete: if false;
    }
    // <<< PTW
    match /checklist_templates/{docId} { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /checklist_runs/{docId}      { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /plans/{docId}               { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /rams/{docId}                { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /signs/{docId}               { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /actions/{docId}             { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /tbt_sessions/{docId}        { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /training_courses/{docId}    { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /training_records/{docId}    { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /training_sessions/{docId}   { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /notifications/{docId}       { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /chemicals/{docId}           { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /audit_logs/{docId}          { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /bbs_observations/{docId}    { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /hazards/{docId}                { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /contractor_companies/{docId}   { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /contractor_workers/{docId}     { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /ppe_items/{docId}              { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /ppe_assignments/{docId}        { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /shift_logs/{docId}             { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /ffd_assessments/{docId}        { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /env_readings/{docId}           { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /legal_compliance_items/{docId} { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /waste_records/{docId}          { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /safety_meetings/{docId}        { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /emergency_plans/{docId}        { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /emergency_drills/{docId}       { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /controlled_documents/{docId}   { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /dsar_requests/{docId}          { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /retention_policies/{docId}     { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /processing_activities/{docId}  { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /data_breaches/{docId}          { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /compliance_tracking/{docId}    { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /rca_records/{docId}            { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /site_access_logs/{docId}       { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /corrective_actions/{docId}     { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }
    match /man_hours_entries/{docId}      { allow read: if isAccessible(resource.data); allow create: if isAccessible(request.resource.data); allow update, delete: if isAccessible(resource.data); }
    match /audits/{docId}                 { allow read: if isOrgScoped(resource.data); allow create: if isOrgScoped(request.resource.data); allow update, delete: if isOrgScoped(resource.data); }

    // ---- Public certificate verification ----
    // The QR code on a training certificate opens a page that anyone can view
    // without signing in, so this ONE collection is publicly readable - but
    // only a single document at a time, by its exact code. The code is a random
    // 100-bit string nobody can guess, and `list` is denied so the collection
    // can never be enumerated. Documents hold only name, course, issuer, dates
    // and status: no email, ID numbers, scores or project data.
    //
    // Writes are limited to the roles that can run training sessions in the app
    // (the same four that hold the training update permission). Training
    // records themselves are writable by any org member, so the public document
    // - not the private record - is what a verifier trusts, and it gets the
    // tighter rule. A custom role not listed here cannot issue certificates.
    function canIssueCertificates() {
      return isSignedIn() && myRole() in ['ADMIN', 'ORG_ADMIN', 'HSE_MANAGER', 'SUPERVISOR'];
    }

    match /certificate_verifications/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if canIssueCertificates()
                    && isOrgScoped(request.resource.data)
                    && request.resource.data.code == code
                    && request.resource.data.status == 'valid';
      allow update: if canIssueCertificates()
                    && isOrgScoped(resource.data)
                    && request.resource.data.org_id == resource.data.org_id
                    && request.resource.data.code == resource.data.code;
      allow delete: if canIssueCertificates() && isOrgScoped(resource.data);
    }

    // Everything not explicitly matched above is denied by default — this is
    // Firestore's normal behavior, not something this file has to state.
  }
}
