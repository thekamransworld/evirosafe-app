# Firebase Configuration (Public)
#
# Values here are read by src/firebase.ts, falling back to the production
# project if a variable is left blank - so this file being empty (as
# shipped) doesn't break anything by itself.
#
# For local development, don't edit this file - instead copy these variable
# names into a new file called .env.local (already git-ignored, same as
# .env) and fill in your dev/staging Firebase project's values there. Get
# these from the Firebase Console: Project Settings -> General -> Your apps
# -> SDK setup and configuration -> Config.
#
# Vercel: set these same variable names under Project Settings ->
# Environment Variables, scoped to "Preview" with the dev project's values,
# and scoped to "Production" with the real prod project's values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Gemini AI Key (Secret - Do not commit real key here)
VITE_GEMINI_API_KEY=AIzaSyCGdDqNex9liSCFUe3V0eqfrdMnbTxAvwk

# Sentry error monitoring (Public - DSNs are safe to expose client-side)
#
# Leave blank to disable error reporting entirely (src/lib/errorReporting.ts
# checks for this and no-ops if unset - local dev works fine without it).
# Get this from sentry.io -> your project -> Settings -> Client Keys (DSN).
# Same dev/prod split idea as Firebase: either use one Sentry project with
# environment tagging (handled automatically via import.meta.env.MODE), or
# two separate DSNs the same way Firebase uses two separate projects.
VITE_SENTRY_DSN=
